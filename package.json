{
  "name": "sfcollab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --config vitest.a11y.config.js",
    "deploy": "npm run build && aws s3 sync dist s3://sf-collab --delete --exclude \"uploads/*\" && aws cloudfront create-invalidation --distribution-id E2SNXEBSFRTHFE --paths \"/*\"",
    "deploy:no-images": "npm run build && aws s3 sync dist s3://sf-collab --delete --exclude \"*\" --include \"*.html\" --include \"*.css\" --include \"*.js\" --include \"*.map\" --profile sforger && aws cloudfront create-invalidation --distribution-id E2SNXEBSFRTHFE --paths \"/*\" --profile sforger",
    "deploy:dev": "npm run build && aws s3 sync dist s3://sf-collab-pre-deploy --delete --exclude \"uploads/*\" --profile sforger && aws cloudfront create-invalidation --distribution-id E1QYCFGNGX3SX4 --paths \"/*\" --profile sforger",
    "lint": "eslint ."
  },
